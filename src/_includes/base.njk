<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and title != site.title %}{{ title }} | {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.intro }}">
  <meta name="theme-color" content="#0c1d22">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Literata:ital,opsz,wght@0,7..72,300..800;1,7..72,300..800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='15' fill='%230c1d22'/><path d='M4 18c4-3 8 3 12 0s8 3 12 0v8H4z' fill='%233fa6a0'/><path d='M4 22c4-3 8 3 12 0s8 3 12 0v6H4z' fill='%2365b37f'/></svg>">
</head>
<body>
  <a class="skip" href="#main">Skip to the letters</a>

  <header class="masthead">
    <a class="masthead__name" href="/">{{ site.missionaryName }}</a>
    <nav class="masthead__nav" aria-label="Main">
      <a href="/#letters">Letters</a>
      <a href="#subscribe">Get her emails</a>
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  {% if not hideSubscribe %}{% include "subscribe.njk" %}{% endif %}

  <footer class="footer">
    <p>Letters from {{ site.missionaryName }}, serving in the {{ site.mission }}.</p>
    <p>Shared by her family. &copy; {{ "" | year }}</p>
  </footer>
</body>
</html>
