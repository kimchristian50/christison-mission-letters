{# The signup form. Submissions go to Web3Forms, which emails each new
   address to whoever the access key in src/_data/site.json belongs to. #}
<section class="subscribe" id="subscribe" aria-labelledby="subscribe-heading">
  <div class="subscribe__inner">
    <h2 id="subscribe-heading">Get her weekly email</h2>
    <p>Leave your email address and {{ site.missionaryName }} will add you to her mailing list. Her letters usually go out on Wednesdays.</p>

    <form class="subscribe__form" method="POST" action="https://api.web3forms.com/submit">
      <input type="hidden" name="access_key" value="{{ site.web3formsKey }}">
      <input type="hidden" name="subject" value="New signup for your mission email list">
      <input type="hidden" name="from_name" value="{{ site.title }}">
      <input type="hidden" name="redirect" value="{{ site.url }}/thanks/">
      <input type="checkbox" name="botcheck" class="hidden-field" tabindex="-1" autocomplete="off" aria-hidden="true">

      <div class="field">
        <label for="sub-name">Your name</label>
        <input id="sub-name" name="name" type="text" autocomplete="name" placeholder="So she knows who you are">
      </div>
      <div class="field">
        <label for="sub-email">Email address</label>
        <input id="sub-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com">
      </div>
      <button type="submit">Add me to her list</button>
    </form>
  </div>
</section>
